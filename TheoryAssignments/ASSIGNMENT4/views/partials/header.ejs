<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css"/>
  <link rel="stylesheet" href="/catalog.css"/>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;900&family=Barlow:wght@300;400;500;600&display=swap" rel="stylesheet"/>
</head>
<body>

  <!-- ===== NAV ===== -->
  <header class="header">
    <nav class="nav">
      <div class="nav__top">
        <ul class="nav__utility">
          <li><a href="#">Find a Store</a></li>
          <li>|</li>
          <li><a href="#">Help</a></li>
          <li>|</li>
          <li><a href="#">Join</a></li>
          <li>|</li>
          <li><a href="#">Log In</a></li>
        </ul>
      </div>
      <div class="nav__main">
        <div class="nav__logo">
          <a href="/"><img src="/Assets/logo.jpg" alt="Adidas Logo" style="width:80px;display:block;"/></a>
        </div>

        <ul class="nav__links" id="navLinks">
          <li><a href="/men"      onclick="closeMenu()">Men</a></li>
          <li><a href="/women"    onclick="closeMenu()">Women</a></li>
          <li><a href="/kids"     onclick="closeMenu()">Kids</a></li>
          <li><a href="/sport"    onclick="closeMenu()">Sport</a></li>
          <li class="nav__sale"><a href="/sale" onclick="closeMenu()">Sale</a></li>
          <li><a href="/products" onclick="closeMenu()">Products</a></li>
        </ul>

        <div class="nav__actions">

          <!-- Search icon -->
          <button class="icon-btn" aria-label="Search" onclick="toggleSearch()">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
            </svg>
          </button>

          <!-- Search dropdown -->
          <div class="nav__search-box" id="searchBox" style="display:none;">
            <form action="/products" method="GET">
              <input
                type="text"
                name="search"
                placeholder="Search products..."
                class="nav__search-input"
                id="searchInput"
                autocomplete="off"
              />
              <button type="submit" class="btn btn--black">Go</button>
            </form>
          </div>

          <button class="icon-btn" aria-label="Favourites">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
            </svg>
          </button>
          <button class="icon-btn cart-btn" aria-label="Cart">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
              <path d="M1 1h4l2.68 13.39a2 2 0 001.99 1.61h9.72a2 2 0 001.99-1.61L23 6H6"/>
            </svg>
            <span class="cart-count">3</span>
          </button>
          <button class="nav__hamburger" id="hamburgerBtn" aria-label="Toggle menu" aria-expanded="false">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </nav>
  </header>

  <script>
    function toggleSearch() {
      const box = document.getElementById('searchBox');
      box.style.display = box.style.display === 'none' ? 'flex' : 'none';
      if (box.style.display === 'flex') {
        document.getElementById('searchInput').focus();
      }
    }

    // Close search box if clicked outside
    document.addEventListener('click', function(e) {
      const box = document.getElementById('searchBox');
      const btn = document.querySelector('[aria-label="Search"]');
      if (!box.contains(e.target) && !btn.contains(e.target)) {
        box.style.display = 'none';
      }
    });
  </script>
