<%- include('partials/header') %>

<section style="padding-top:120px; max-width:900px; margin:0 auto; padding-left:24px; padding-right:24px; padding-bottom:60px;">

  <h1 style="font-family:'Barlow Condensed',sans-serif; font-size:48px; font-weight:900; text-transform:uppercase; margin-bottom:8px;">
    Your Cart
  </h1>

  <% if (success) { %>
    <div style="background:#e0ffe6; color:#080; padding:14px 20px; border-radius:4px; margin-bottom:24px; font-weight:600;">
      ✅ <%= success %>
    </div>
  <% } %>

  <% if (error) { %>
    <div style="background:#ffe0e0; color:#c00; padding:14px 20px; border-radius:4px; margin-bottom:24px; font-weight:600;">
      ⚠️ <%= error %>
    </div>
  <% } %>

  <% if (items.length === 0) { %>
    <!-- ── Empty cart state ── -->
    <div style="text-align:center; padding:80px 0;">
      <div style="font-size:64px; margin-bottom:16px;">🛒</div>
      <h2 style="font-family:'Barlow Condensed',sans-serif; font-size:32px; font-weight:700; text-transform:uppercase; color:#0C0C0C; margin-bottom:12px;">
        Your cart is empty
      </h2>
      <p style="color:#767676; font-size:15px; margin-bottom:32px;">
        Looks like you haven't added anything yet.
      </p>
      <a href="/products" class="btn btn--black" style="display:inline-block; padding:14px 40px; font-size:14px;">
        Continue Shopping
      </a>
    </div>

  <% } else { %>

    <!-- ── Cart items table ── -->
    <div style="border:1px solid #e5e5e5; border-radius:4px; overflow:hidden; margin-bottom:32px;">
      <table style="width:100%; border-collapse:collapse;">
        <thead>
          <tr style="background:#f5f5f5; border-bottom:1px solid #e5e5e5;">
            <th style="padding:14px 20px; text-align:left; font-family:'Barlow Condensed',sans-serif; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:1px;">Product</th>
            <th style="padding:14px 20px; text-align:center; font-family:'Barlow Condensed',sans-serif; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:1px;">Price</th>
            <th style="padding:14px 20px; text-align:center; font-family:'Barlow Condensed',sans-serif; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:1px;">Qty</th>
            <th style="padding:14px 20px; text-align:center; font-family:'Barlow Condensed',sans-serif; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:1px;">Subtotal</th>
            <th style="padding:14px 20px;"></th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(function(item) { %>
            <tr style="border-bottom:1px solid #f0f0f0;">
              <!-- Product image + name -->
              <td style="padding:20px;">
                <div style="display:flex; align-items:center; gap:16px;">
                  <% if (item.image) { %>
                    <img src="/<%= item.image %>" alt="<%= item.name %>"
                         style="width:70px; height:70px; object-fit:cover; border-radius:4px; background:#f5f5f5; flex-shrink:0;" />
                  <% } else { %>
                    <div style="width:70px; height:70px; background:#f5f5f5; border-radius:4px; flex-shrink:0;"></div>
                  <% } %>
                  <div>
                    <div style="font-family:'Barlow Condensed',sans-serif; font-size:16px; font-weight:700; color:#0C0C0C;">
                      <%= item.name %>
                    </div>
                    <div style="font-size:12px; color:#767676; margin-top:2px;">
                      <%= item.category %>
                    </div>
                  </div>
                </div>
              </td>

              <!-- Unit price -->
              <td style="padding:20px; text-align:center; font-family:'Barlow Condensed',sans-serif; font-size:16px; font-weight:700;">
                $<%= item.price.toFixed(2) %>
              </td>

              <!-- Quantity update form -->
              <td style="padding:20px; text-align:center;">
                <form action="/cart/update" method="POST" style="display:inline-flex; align-items:center; gap:6px;">
                  <input type="hidden" name="productId" value="<%= item.productId %>" />
                  <input type="number" name="quantity" value="<%= item.quantity %>" min="1" max="99"
                         style="width:52px; padding:6px 8px; border:1px solid #ccc; border-radius:4px; text-align:center; font-size:14px;"
                         onchange="this.form.submit()" />
                </form>
              </td>

              <!-- Subtotal -->
              <td style="padding:20px; text-align:center; font-family:'Barlow Condensed',sans-serif; font-size:16px; font-weight:800; color:#0C0C0C;">
                $<%= (item.price * item.quantity).toFixed(2) %>
              </td>

              <!-- Remove button -->
              <td style="padding:20px; text-align:center;">
                <form action="/cart/remove" method="POST">
                  <input type="hidden" name="productId" value="<%= item.productId %>" />
                  <button type="submit"
                          style="background:none; border:none; cursor:pointer; color:#767676; font-size:18px; padding:4px 8px;"
                          title="Remove item">✕</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- ── Order summary & place order ── -->
    <div style="display:flex; justify-content:flex-end;">
      <div style="min-width:320px; background:#f5f5f5; border-radius:4px; padding:28px 32px;">
        <h3 style="font-family:'Barlow Condensed',sans-serif; font-size:22px; font-weight:800; text-transform:uppercase; margin-bottom:20px;">
          Order Summary
        </h3>

        <div style="display:flex; justify-content:space-between; font-size:14px; color:#555; margin-bottom:10px;">
          <span>Items (<%= items.length %>)</span>
          <span>$<%= total %></span>
        </div>
        <div style="display:flex; justify-content:space-between; font-size:14px; color:#555; margin-bottom:10px;">
          <span>Shipping</span>
          <span style="color:#16a34a; font-weight:600;">FREE</span>
        </div>
        <div style="border-top:1px solid #ddd; margin:16px 0;"></div>
        <div style="display:flex; justify-content:space-between; font-family:'Barlow Condensed',sans-serif; font-size:22px; font-weight:800; margin-bottom:24px;">
          <span>Total</span>
          <span>$<%= total %></span>
        </div>

        <!-- Place Order -->
        <form action="/cart/place-order" method="POST">
          <button type="submit" class="btn btn--black"
                  style="width:100%; padding:16px; font-size:15px; font-weight:700; cursor:pointer;">
            Place Order
          </button>
        </form>

        <a href="/products" style="display:block; text-align:center; margin-top:14px; font-size:13px; color:#767676; text-decoration:underline;">
          ← Continue Shopping
        </a>
      </div>
    </div>

  <% } %>
</section>

<%- include('partials/footer') %>
