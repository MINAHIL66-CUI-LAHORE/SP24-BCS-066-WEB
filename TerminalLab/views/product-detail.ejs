<%- include('partials/header') %>

<section class="products" style="padding-top: 120px; max-width: 800px; margin: 0 auto; padding-left: 24px; padding-right: 24px; padding-bottom: 60px;">
  <a href="/products" class="see-all" style="display:inline-flex;margin-bottom:24px;">← All Products</a>

  <% if (locals.query && query.added) { %>
    <div style="background:#e0ffe6; color:#080; padding:12px 18px; border-radius:4px; margin-bottom:20px; font-weight:600;">
      ✅ Product added to your cart! <a href="/cart" style="color:#080; text-decoration:underline;">View Cart</a>
    </div>
  <% } %>

  <div style="display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:start;">
    <% if (product.image) { %>
      <img src="/<%= product.image %>" alt="<%= product.name %>"
           style="width:100%;border-radius:4px;background:#f5f5f5;"/>
    <% } %>
    <div>
      <p class="product-card__label"><%= product.label %></p>
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-size:48px;font-weight:900;text-transform:uppercase;margin-bottom:16px;">
        <%= product.name %>
      </h2>

      <% if (product.colors && product.colors.length) { %>
        <div class="product-card__colors" style="margin-bottom:20px;">
          <% product.colors.forEach(function(c) { %>
            <span class="swatch" style="background:<%= c %>;width:24px;height:24px;"></span>
          <% }) %>
        </div>
      <% } %>

      <div class="product-card__price" style="margin-bottom:24px;">
        <span class="price--current" style="font-size:24px;">
          $<%= product.price.toFixed(2) %>
        </span>
      </div>

      <!-- ── Add to Cart form ── -->
      <form action="/cart/add" method="POST">
        <input type="hidden" name="productId" value="<%= product._id %>" />

        <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
          <label style="font-size:13px; font-weight:600; color:#555;">Qty:</label>
          <input type="number" name="quantity" value="1" min="1" max="99"
                 style="width:60px; padding:10px 12px; border:1px solid #ccc; border-radius:4px; font-size:14px; text-align:center;" />
        </div>

        <button type="submit" class="btn btn--black" style="width:100%;padding:18px;font-size:15px;font-weight:700;cursor:pointer;">
          Add to Cart
        </button>
      </form>

      <a href="/cart" style="display:block; text-align:center; margin-top:12px; font-size:13px; color:#767676; text-decoration:underline;">
        View Cart
      </a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
