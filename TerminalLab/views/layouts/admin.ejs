<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Admin | Adidas' %></title>

  <!-- Google Fonts -->
  <link
    href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Barlow:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <!-- Shared admin styles -->
  <link rel="stylesheet" href="/admin.css" />

  <!-- jQuery -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"
          integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
          crossorigin="anonymous"></script>

  <%- typeof style !== 'undefined' ? style : '' %>
</head>
<body class="admin-body">

  <%- include('../partials/admin-sidebar') %>

  <main class="admin-main">
    <%- body %>
  </main>

  <%- typeof script !== 'undefined' ? script : '' %>

</body>
</html>