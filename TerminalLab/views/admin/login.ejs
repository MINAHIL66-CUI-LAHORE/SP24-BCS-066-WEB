<%# views/admin/login.ejs – Adidas-themed split screen login %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/admin.css" />
</head>
<body class="admin-login-body">

  <!-- ── Left: moving image panel ─────────────────────────── -->
  <div class="login-bg">
    <img
      src="/Assets/admin1.jpg"
      alt="Adidas"
      class="login-bg-img"
    />
    <div class="login-bg-overlay"></div>
    <div class="login-bg-brand">
      <img src="/Assets/logo.jpg" alt="Adidas" class="login-bg-brand-logo" />
      <div class="login-bg-tagline">
        Impossible<br>Is Nothing.
      </div>
    </div>
  </div>

  <!-- ── Right: login form panel ───────────────────────────── -->
  <div class="login-panel">

    <img src="/Assets/logo.jpg" alt="Adidas" class="login-panel-logo" />

    <h1 class="login-title">Admin Panel</h1>
    <p class="login-subtitle">Sign in to manage your store</p>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form action="/admin/login" method="POST" class="login-form">
      <div class="form-group">
        <label for="password" class="form-label">
          Password <span class="required">*</span>
        </label>
        <input
          type="password"
          id="password"
          name="password"
          class="form-input"
          placeholder="Enter admin password"
          autofocus
          required
        />
      </div>

      <div class="login-divider"></div>

      <button type="submit" class="btn btn-primary btn-block">
        Sign In
      </button>
    </form>

    <p class="login-back"><a href="/">← Back to store</a></p>
  </div>

</body>
</html>
